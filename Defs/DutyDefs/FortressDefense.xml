<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DutyDef>
    <defName>RS_FortressGuard</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimSiege.Fortress.JobGiver_FortressGun" />
        <li Class="RimSiege.Fortress.JobGiver_FortressFight">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>75</targetKeepRadius>
          <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
        </li>
        <li Class="RimSiege.Fortress.JobGiver_FortressPost" />
        <li Class="JobGiver_WanderNearDutyLocation"><wanderRadius>5</wanderRadius></li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RS_FortressReserve</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_PrioritySorter">
          <subNodes>
            <li Class="JobGiver_GetFood"><maxLevelPercentage>0.30</maxLevelPercentage></li>
            <li Class="JobGiver_GetRest"><maxLevelPercentage>0.40</maxLevelPercentage></li>
          </subNodes>
        </li>
        <li Class="RimSiege.Fortress.JobGiver_FortressSupport" />
        <li Class="RimSiege.Fortress.JobGiver_FortressMaintenance" />
        <li Class="RimSiege.Fortress.JobGiver_FortressFight">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>75</targetKeepRadius>
          <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
        </li>
        <li Class="RimSiege.Fortress.JobGiver_FortressPost" />
        <li Class="JobGiver_WanderNearDutyLocation"><wanderRadius>6</wanderRadius></li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RS_FortressRecover</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimSiege.Fortress.JobGiver_FortressPost" />
        <li Class="RimSiege.Fortress.JobGiver_FortressSelfTend" />
        <li Class="RimSiege.Fortress.JobGiver_FortressMedicalRest"><respectTimetable>false</respectTimetable></li>
        <li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li>
        <li Class="JobGiver_WanderNearDutyLocation"><wanderRadius>4</wanderRadius></li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RS_FortressSortie</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimSiege.Fortress.JobGiver_FortressPost" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>75</targetKeepRadius>
        </li>
        <li Class="JobGiver_AITrashDutyFocus" />
        <li Class="JobGiver_WanderNearDutyLocation"><wanderRadius>5</wanderRadius></li>
      </subNodes>
    </thinkNode>
  </DutyDef>
</Defs>
