<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Royalty</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="RS_MechSupportShield"]/graphicData/texPath</xpath>
          <value><texPath>Things/Building/Security/BroadshieldProjector</texPath></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RS_MechSupportShield"]/building</xpath>
          <value><destroyEffecter>Broadshield_Burnout</destroyEffecter></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RS_MechSupportShield"]/comps/li[@Class="CompProperties_ProjectileInterceptor"]</xpath>
          <value><activeSound>Broadshield_Ambience</activeSound></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
